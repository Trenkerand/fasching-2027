<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Fasching Racing Team 2027</title>
<style>
:root{--bg:#101116;--panel:#1b1d25;--line:#343744;--yellow:#ffd12f;--white:#f7f7f8;--muted:#a9adba;--red:#ff5d54}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--white);font:16px/1.5 system-ui,Arial,sans-serif}
header{padding:22px max(22px,calc((100% - 1080px)/2));border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.logo{font-weight:900;letter-spacing:.08em}.logo span{color:var(--yellow)}a,button{cursor:pointer}
.hero{max-width:1080px;margin:auto;padding:65px 22px 45px}.eyebrow{color:var(--yellow);font-weight:800;letter-spacing:.14em;font-size:.8rem}
h1{font-size:clamp(2.6rem,7vw,5.6rem);line-height:.98;margin:14px 0 20px;text-transform:uppercase}h1 span{color:var(--yellow)}
.hero p{color:var(--muted);max-width:650px}.tag{display:inline-block;border:1px solid var(--yellow);padding:8px 12px;margin-top:15px;font-weight:800;font-size:.8rem}
main{max-width:1080px;margin:auto;padding:0 22px 70px}.section{margin:30px 0}.section h2{font-size:1.6rem}.events{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px}
.event{background:var(--panel);border:1px solid var(--line);padding:16px;border-radius:12px;display:flex;gap:12px;align-items:center}.event input{accent-color:var(--yellow);width:18px;height:18px}.event small{display:block;color:var(--muted)}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:22px;margin-top:18px}
.fields{display:grid;grid-template-columns:1fr 1fr;gap:14px}.field label{display:block;color:var(--muted);font-size:.75rem;font-weight:800;margin-bottom:5px;letter-spacing:.06em}
input,textarea{width:100%;padding:13px;background:#11131a;color:white;border:1px solid var(--line);border-radius:8px;font:inherit}textarea{min-height:90px}
button{border:0;background:var(--yellow);color:#171717;padding:12px 18px;border-radius:8px;font-weight:900;font:inherit}button.secondary{background:#30333e;color:white;border:1px solid #505463}button:disabled{opacity:.5}
.msg{margin-top:14px;color:var(--yellow)}.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:16px 0}.tab{background:#30333e;color:white}.tab.active{background:var(--yellow);color:#111}
.tablewrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:600px}th,td{text-align:left;padding:11px;border-bottom:1px solid var(--line)}th{color:var(--yellow);font-size:.8rem}
.hidden{display:none!important}.muted{color:var(--muted)}.adminhead{display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap}
footer{border-top:1px solid var(--line);padding:25px;text-align:center;color:var(--muted)}@media(max-width:650px){.fields{grid-template-columns:1fr}.hero{padding-top:45px}}
</style></head>
<body>
<header><div class="logo">🏁 FASCHING <span>RACING TEAM</span></div><a href="#veranstalter" style="color:var(--yellow)">Veranstalterbereich</a></header>
<section class="hero"><div class="eyebrow">MOTORSPORT • FASCHING • TEAMGEIST</div><h1>Die Startampel<br><span>steht auf Fasching!</span></h1><p>Heuer bringen wir das Formel-1-Feeling auf die Straße! Ob Rennfahrer, Boxencrew oder Motorsport-Fan – melde dich an und sei dabei.</p><div class="tag">AB 18 JAHREN · MAX. 70 PLÄTZE PRO UMZUG</div></section>
<main>
<section class="section"><h2>🏎️ Bei welchen Faschingsumzügen bist du dabei?</h2><div class="events" id="events">
<label class="event"><input type="checkbox" value="Triftern"><span><b>Triftern</b><small>Faschingsumzug</small></span></label>
<label class="event"><input type="checkbox" value="Tettenweis"><span><b>Tettenweis</b><small>Faschingsumzug</small></span></label>
<label class="event"><input type="checkbox" value="Neuötting"><span><b>Neuötting</b><small>Faschingsumzug</small></span></label>
<label class="event"><input type="checkbox" value="Eggenfelden"><span><b>Eggenfelden</b><small>Faschingsumzug</small></span></label>
<label class="event"><input type="checkbox" value="Wurmannsquick"><span><b>Wurmannsquick</b><small>Faschingsumzug</small></span></label>
<label class="event"><input type="checkbox" value="Peterskirchen"><span><b>Peterskirchen</b><small>Faschingsumzug</small></span></label></div></section>
<section class="section panel"><h2>Deine Anmeldung</h2><p class="muted">Bitte fülle alle Pflichtfelder aus. Teilnahme ab 18 Jahren.</p>
<form id="signup"><div class="fields">
<div class="field"><label>VOR- UND NACHNAME *</label><input id="name" required></div>
<div class="field"><label>ALTER *</label><input id="age" type="number" min="18" max="110" required></div>
<div class="field"><label>E-MAIL *</label><input id="email" type="email" required></div>
<div class="field"><label>TELEFONNUMMER *</label><input id="phone" type="tel" required></div>
<div class="field" style="grid-column:1/-1"><label>ANMERKUNGEN (OPTIONAL)</label><textarea id="notes"></textarea></div></div>
<p><button id="submit">Anmeldung absenden</button></p><div id="signupMsg" class="msg" role="status"></div></form></section>
<section class="section panel" id="veranstalter"><div class="adminhead"><div><h2>🔒 Veranstalterbereich</h2><p class="muted">Nur für die Organisation sichtbar.</p></div></div>
<div id="loginBox"><form id="loginForm"><div class="field"><label>VERANSTALTER-PASSWORT</label><input id="password" type="password" required autocomplete="current-password"></div><p><button>Anmelden</button></p><div id="loginMsg" class="msg"></div></form></div>
<div id="dashboard" class="hidden"><div class="adminhead"><p class="muted" id="refreshInfo">Noch nicht aktualisiert</p><div><button id="refresh" type="button">E-Mails jetzt aktualisieren</button> <button id="logout" type="button" class="secondary">Abmelden</button></div></div>
<div class="tabs" id="tabs"></div><div id="people" class="tablewrap"></div><h3>Eingegangene Faschings-E-Mails</h3><div id="emails" class="tablewrap"></div><p class="muted">Automatisch erkannte oder unvollständige Angaben bitte kontrollieren. Die Erkennung von Tabellen hängt vom Aufbau der jeweiligen E-Mail ab.</p></div>
</section></main><footer>🏁 LET'S RACE INTO FASCHING 2027!</footer>
<script>
const $=id=>document.getElementById(id);
async function api(url,options={}){const r=await fetch(url,{...options,headers:{'Content-Type':'application/json',...(options.headers||{})}});const d=await r.json().catch(()=>({}));if(!r.ok)throw new Error(d.error||'Es ist ein Fehler aufgetreten.');return d;}
$('signup').addEventListener('submit',async e=>{e.preventDefault();const events=[...document.querySelectorAll('#events input:checked')].map(x=>x.value);if(!events.length){$('signupMsg').textContent='Bitte wähle mindestens einen Umzug.';return;}const data={name:$('name').value.trim(),age:Number($('age').value),email:$('email').value.trim(),phone:$('phone').value.trim(),notes:$('notes').value.trim(),events};$('submit').disabled=true;try{const d=await api('/api/register',{method:'POST',body:JSON.stringify(data)});$('signupMsg').textContent=d.message;$('signup').reset();}catch(err){$('signupMsg').textContent=err.message;}finally{$('submit').disabled=false;}});
$('loginForm').addEventListener('submit',async e=>{e.preventDefault();try{await api('/api/login',{method:'POST',body:JSON.stringify({password:$('password').value})});$('loginBox').classList.add('hidden');$('dashboard').classList.remove('hidden');$('password').value='';await loadDashboard();}catch(err){$('loginMsg').textContent=err.message;}});
$('logout').onclick=async()=>{await api('/api/logout',{method:'POST'});$('dashboard').classList.add('hidden');$('loginBox').classList.remove('hidden');};
$('refresh').onclick=async()=>{ $('refresh').disabled=true;$('refreshInfo').textContent='GMX-Postfach wird abgerufen …';try{const d=await api('/api/refresh',{method:'POST'});$('refreshInfo').textContent='Zuletzt aktualisiert: '+new Date(d.refreshedAt||Date.now()).toLocaleString('de-DE');await loadDashboard();}catch(e){$('refreshInfo').textContent=e.message;}finally{$('refresh').disabled=false;}};
let current="Alle";
async function loadDashboard(){try{const d=await api('/api/dashboard');$('refreshInfo').textContent=d.lastRefresh?'Zuletzt aktualisiert: '+new Date(d.lastRefresh).toLocaleString('de-DE'):'Noch kein erfolgreicher E-Mail-Abruf';const names=['Alle',...d.events];$('tabs').innerHTML=names.map(n=>`<button class="tab ${n===current?'active':''}" data-event="${n}">${n}</button>`).join('');$('tabs').querySelectorAll('button').forEach(b=>b.onclick=()=>{current=b.dataset.event;renderPeople(d);loadDashboard();});renderPeople(d);$('emails').innerHTML=d.emails.length?`<table><tr><th>Datum</th><th>Absender</th><th>Betreff</th><th>Status</th></tr>${d.emails.map(m=>`<tr><td>${new Date(m.received_at).toLocaleString('de-DE')}</td><td>${esc(m.from_addr)}</td><td>${esc(m.subject)}</td><td>${esc(m.status)}</td></tr>`).join('')}</table>`:'<p class="muted">Noch keine passenden Faschings-E-Mails gefunden.</p>';}catch(e){if(e.message.includes('anmelden')){$('dashboard').classList.add('hidden');$('loginBox').classList.remove('hidden');}}}
function renderPeople(d){const rows=d.participants.filter(p=>current==='Alle'||p.parade===current);$('people').innerHTML=rows.length?`<table><tr><th>Name</th><th>Alter</th><th>Faschingsumzug</th><th>E-Mail</th><th>Telefon</th><th>Prüfung</th></tr>${rows.map(p=>`<tr><td>${esc(p.name)}</td><td>${esc(p.age)}</td><td>${esc(p.parade||'Nicht erkannt')}</td><td>${esc(p.contact_email)}</td><td>${esc(p.phone)}</td><td>${esc(p.confidence)}</td></tr>`).join('')}</table>`:'<p class="muted">Für diese Auswahl gibt es noch keine erkannten Teilnehmer.</p>';}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
// Dashboard-Daten im geöffneten Veranstalterbereich alle fünf Minuten neu laden.
setInterval(()=>{if(!$('dashboard').classList.contains('hidden'))loadDashboard();},5*60*1000);
</script></body></html>
